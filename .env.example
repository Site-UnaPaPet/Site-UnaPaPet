# URL do backend (sem barra no final). Toda variável lida pelo frontend precisa começar com VITE_.
VITE_API_URL=http://localhost:8000

# Backend (obrigatórias)
# Segredo para assinar os tokens JWT. Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Origens permitidas no CORS, separadas por vírgula. Em produção use as URLs do site, nunca *
ORIGIN=http://localhost:5173
# Requisições por minuto por cliente e no total
RATE_LIMIT=60
GLOBAL_RATE_LIMIT=1000

# Backend (opcionais)
# Sem URL_DB usa o SQLite local. Postgres: postgresql://usuario:senha@host:5432/banco
URL_DB=sqlite:///data/data.db
# false só para desenvolver em http (em produção deixe true)
COOKIE_SECURE=false

# Admin criado pelo comando: python -m src.backend.main create_admin (obrigatórias para esse comando)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
