# Frontend (React + Vite) - ambiente de desenvolvimento
# Build (na raiz do projeto): docker build -f Dockerfile.interface -t unapapet-frontend .
# Run: docker run --rm -p 5173:5173 -e VITE_API_URL=http://localhost:3000 unapapet-frontend
FROM node:22-alpine

WORKDIR /app

# Instala as dependências primeiro (aproveita o cache do Docker)
COPY src/frontend/package*.json ./
RUN npm ci

# Copia o código do frontend
COPY src/frontend/ ./

EXPOSE 5173

# --host é necessário para o servidor ser acessível de fora do container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
